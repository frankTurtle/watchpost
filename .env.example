# Copy to .env.local; leave Supabase vars unset to run in demo mode.

# Supabase public URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (for client-side reads)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Admin password: protects /admin and write APIs when set
# Feature lands in a later PR
ADMIN_PASSWORD=
